# NEP Analytics Chat — Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Supabase
SUPABASE_URL=https://mybdvsxiynpdbuzmtquu.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Anthropic (Claude claude-sonnet-4-5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Security — used as x-api-key header in all requests
API_SECRET_KEY=change_this_to_a_random_32_char_string

# CORS — comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Limits
MAX_HISTORY_TURNS=10
MAX_RESULT_ROWS=500
